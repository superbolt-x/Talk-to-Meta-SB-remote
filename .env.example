META_ACCESS_TOKEN=your_meta_access_token
META_APP_SECRET=your_app_secret_optional
META_APP_ID=your_app_id_optional
VAULT_PATH=/path/to/your/marketing-vault

# Remote HTTP server settings
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Public Railway URL (no trailing slash, no /mcp) — pins the Host allowlist
SERVER_URL=https://your-service.up.railway.app

# ── Authless / Parker-style gate ──────────────────────────────────────────────
# No OAuth: Claude connects with no login step. When set, this token is required
# on every MCP request — embed it in the connector URL:
#   https://your-service.up.railway.app/mcp?access_token=THIS_TOKEN
# (or send Authorization: Bearer THIS_TOKEN). Empty = fully open.
# KEEP THIS SET — Meta can spend money and delete campaigns.
# Generate a strong random token: python -c "import secrets; print(secrets.token_hex(32))"
MCP_AUTH_TOKEN=your_strong_random_token_here
